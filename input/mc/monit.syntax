    keyword whole operation cyan
    keyword whole operations cyan
    keyword whole xoperation cyan
    keyword whole xoperations cyan
    keyword whole packet cyan
    keyword whole packets cyan
    keyword whole byte cyan
    keyword whole bytes cyan
    keyword whole kilobyte cyan
    keyword whole kilobytes cyan
    keyword whole megabyte cyan
    keyword whole megabytes cyan
    keyword whole gigabyte cyan
    keyword whole gigabytes cyan
    keyword whole kb cyan
    keyword whole mb cyan
