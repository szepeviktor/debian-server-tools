# Syntax highlighting for Monit control files
#
# Install this file as:
#   ~/.local/share/mc/syntax/monit.syntax
#
# Add these lines to ~/.local/share/mc/syntax/Syntax before the generic
# *.cfg/*.conf rule:
#
#   file (\\.?monitrc|.\*\\.(monit|monitrc))$ Monit\scontrol\sfile
#   include monit.syntax
#
# https://github.com/lutzmad/vscode-monitrc

caseinsensitive

wholechars abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-.

context default

# Top-level statements
    keyword whole set brightcyan
    keyword whole check brightcyan
    keyword whole include brightcyan

# Service types and major clauses
    keyword whole process yellow
    keyword whole file yellow
    keyword whole filesystem yellow
    keyword whole directory yellow
    keyword whole host yellow
    keyword whole network yellow
    keyword whole system yellow
    keyword whole fifo yellow
    keyword whole program yellow
    keyword whole daemon yellow
    keyword whole interval yellow
    keyword whole alert yellow
    keyword whole terminal yellow
    keyword whole init yellow
    keyword whole onreboot yellow
    keyword whole expectbuffer yellow
    keyword whole limits yellow
    keyword whole fips yellow
    keyword whole logfile yellow
    keyword whole log yellow
    keyword whole eventqueue yellow
    keyword whole idfile yellow
    keyword whole statefile yellow
    keyword whole pidfile yellow
    keyword whole mmonit yellow
    keyword whole mailserver yellow
    keyword whole mail-format yellow
    keyword whole httpd yellow
    keyword whole path yellow
    keyword whole address yellow
    keyword whole interface yellow
    keyword whole matching yellow
    keyword whole match yellow

# Conditions and flow control
    keyword whole if brightcyan
    keyword whole then brightcyan
    keyword whole else brightcyan
    keyword whole failed brightcyan
    keyword whole succeeded brightcyan
    keyword whole passed brightcyan
    keyword whole recovered brightcyan
    keyword whole changed brightcyan
    keyword whole exist brightcyan
    keyword whole exists brightcyan
    keyword whole nonexist brightcyan
    keyword whole content brightcyan
    keyword whole status brightcyan
    keyword whole uptime brightcyan
    keyword whole every brightcyan
    keyword whole repeat brightcyan
    keyword whole reminder brightcyan
    keyword whole timeout brightcyan
    keyword whole retry brightcyan
    keyword whole depends brightcyan
    keyword whole depend brightcyan
    keyword whole group brightcyan
    keyword whole mode brightcyan

# Actions
    keyword whole start brightred
    keyword whole stop brightred
    keyword whole restart brightred
    keyword whole monitor brightred
    keyword whole unmonitor brightred
    keyword whole exec brightred
    keyword whole ignore brightred
    keyword whole noalert brightred

# Tests, resources and options
    keyword whole cpu yellow
    keyword whole memory yellow
    keyword whole mem yellow
    keyword whole swap yellow
    keyword whole loadavg yellow
    keyword whole load yellow
    keyword whole threads yellow
    keyword whole thread yellow
    keyword whole children yellow
    keyword whole child yellow
    keyword whole total yellow
    keyword whole read yellow
    keyword whole write yellow
    keyword whole pagein yellow
    keyword whole pageout yellow
    keyword whole inode yellow
    keyword whole space yellow
    keyword whole service yellow
    keyword whole fsflag yellow
    keyword whole fsflags yellow
    keyword whole permission yellow
    keyword whole perm yellow
    keyword whole size yellow
    keyword whole hardlink yellow
    keyword whole uid yellow
    keyword whole euid yellow
    keyword whole gid yellow
    keyword whole security yellow
    keyword whole attribute yellow
    keyword whole attributes yellow
    keyword whole filedescriptors yellow
    keyword whole link yellow
    keyword whole saturation yellow
    keyword whole upload yellow
    keyword whole uploaded yellow
    keyword whole download yellow
    keyword whole downloaded yellow
    keyword whole packetin yellow
    keyword whole packetout yellow
    keyword whole bytein yellow
    keyword whole byteout yellow
    keyword whole speed yellow
    keyword whole checksum yellow
    keyword whole timestamp yellow
    keyword whole atime yellow
    keyword whole ctime yellow
    keyword whole mtime yellow
    keyword whole pid yellow
    keyword whole ppid yellow
    keyword whole responsetime yellow
    keyword whole count yellow
    keyword whole action yellow
    keyword whole connection yellow
    keyword whole instance yellow
    keyword whole invalid yellow
    keyword whole resource yellow
    keyword whole data yellow

