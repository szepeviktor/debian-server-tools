    keyword whole minute cyan
    keyword whole minutes cyan
    keyword whole hour cyan
    keyword whole hours cyan
    keyword whole day cyan
    keyword whole days cyan
    keyword whole month cyan
    keyword whole months cyan
    keyword whole cycle cyan
    keyword whole cycles cyan
    keyword whole time cyan
    keyword whole times cyan

# Noise words used by Monit's natural-language-like grammar
    keyword whole and lightgray
    keyword whole are lightgray
    keyword whole as lightgray
    keyword whole but lightgray
    keyword whole capacity lightgray
    keyword whole does lightgray
    keyword whole for lightgray
    keyword whole has lightgray
    keyword whole in lightgray
    keyword whole is lightgray
    keyword whole last lightgray
    keyword whole of lightgray
    keyword whole on lightgray
    keyword whole only lightgray
    keyword whole option lightgray
    keyword whole options lightgray
    keyword whole or lightgray
    keyword whole per lightgray
    keyword whole program lightgray
    keyword whole programs lightgray
    keyword whole rate lightgray
    keyword whole sum lightgray
    keyword whole than lightgray
    keyword whole the lightgray
    keyword whole to lightgray
    keyword whole use lightgray
    keyword whole using lightgray
    keyword whole via lightgray
    keyword whole was lightgray
    keyword whole with lightgray
    keyword whole within lightgray
    keyword whole without lightgray

# Operators, delimiters, numbers and Monit runtime variables
    keyword == brightgreen
    keyword != brightgreen
    keyword <= brightgreen
    keyword >= brightgreen
    keyword = brightgreen
    keyword < brightgreen
    keyword > brightgreen
    keyword % cyan
    keyword { brightcyan
    keyword } brightcyan
    keyword \\[ brightcyan
    keyword \\] brightcyan
    keyword , brightcyan
    keyword whole \{0123456789\}\[0123456789\] brightcyan
    keyword whole \[0123456789\]\.\{0123456789\}\[0123456789\] brightcyan
    keyword whole \{0123456789\}\[0123456789\]\.\[0123456789\] brightcyan
    keyword whole $EVENT brightmagenta
    keyword whole $SERVICE brightmagenta
    keyword whole $DATE brightmagenta
    keyword whole $HOST brightmagenta
    keyword whole $ACTION brightmagenta
    keyword whole $DESCRIPTION brightmagenta
    keyword whole $SYSTEM brightmagenta

# Quoted strings and shell command strings
context " " green
    keyword \\\" brightgreen
    keyword \\\\ brightgreen

context ' ' green
    keyword \\\' brightgreen
    keyword \\\\ brightgreen

context ` ` green
    keyword \\\` brightgreen
    keyword \\\\ brightgreen

# A hash starts a comment outside quoted contexts.
context exclusive # \n brown
    spellcheck
